# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=your_guild_id_here

# Node Environment
NODE_ENV=development

# Discord adapter (.env); use http://localhost:8080 for local processes.
CORE_API_URL=http://api:8080
CORE_API_TOKEN=replace_with_a_random_shared_token

# Go API only: put the following in .env.api, never in the Bot's .env.
# DATABASE_URL=postgresql://discord_bot:replace_password@db:5432/discord_bot
# CORE_API_TOKEN=replace_with_the_same_shared_token
# DISCORD_BOT_TOKEN=replace_with_the_same_bot_token
# DISCORD_OUTPUT_ENABLED=false
# Keep false during cutover preparation and after restoring a database.
# Set true explicitly once delivery evidence and pending output are verified.

# Logging Configuration
LOG_LEVEL=info

# API Configuration (if needed)
# API_PORT=3000
