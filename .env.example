# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=your_guild_id_here

# Node Environment
NODE_ENV=development

# PostgreSQL Bot role (DML only; administrative credentials belong in .env.db-admin)
DATABASE_URL=postgresql://discord_bot:replace_password@db:5432/discord_bot

# Logging Configuration
LOG_LEVEL=info

# API Configuration (if needed)
# API_PORT=3000
