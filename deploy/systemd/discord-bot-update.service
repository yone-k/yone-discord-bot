[Unit]
Description=Update Discord Bot from GHCR
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=yone
WorkingDirectory=/home/yone/discord-bot
ExecStart=/bin/bash /home/yone/discord-bot/scripts/pi-update.sh
TimeoutStartSec=0
KillMode=control-group
UMask=0077
